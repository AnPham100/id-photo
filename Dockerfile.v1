# V1
# Image size: 4.19 GB

FROM python:3.11-slim-bookworm

# Install system dependencies
RUN apt-get update --allow-releaseinfo-change && apt-get install -y --no-install-recommends \
    # # ___ Build dependencies
    # # `build-essential`: Meta-package that includes gcc (C compiler), g++ (C++ compiler), make (build automation), libc6-dev (C library headers), other essential build tools
    # build-essential \
    # # `python3-dev`: Python development headers needed for compiling Python extensions
    # python3-dev \
    # # `pkg-config`: Tool for managing library compile/link flags
    # pkg-config \
    # ___ OpenCV dependencies (Debian Bookworm compatible)
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgomp1 \
    # ___Utils
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Set environment variables to fix Numba caching issues in Docker
ENV NUMBA_CACHE_DIR=/tmp
ENV NUMBA_DISABLE_JIT=1

# Copy requirements first for better layer caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/passport-specs || exit 1

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
